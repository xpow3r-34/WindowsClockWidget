<Window x:Class="WindowsClockWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Widget Ayarları"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="OnLoaded"
        Background="#F7F7F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Saat / Dakika -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <TextBlock Text="SAAT (HH)" FontSize="12" FontWeight="Bold" Foreground="#1F1E1D" Margin="0,0,0,10"/>
                    <TextBlock Text="Yazı tipi" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="HourFontBox" Height="26" Margin="0,2,0,8"/>
                    <TextBlock Text="Kalınlık" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="HourWeightBox" Height="26" Margin="0,2,0,8"/>
                    <TextBlock Text="Boyut (24-400)" Style="{StaticResource FieldLabel}"/>
                    <Slider x:Name="HourSizeSlider" Minimum="24" Maximum="400" TickFrequency="4"
                            IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                    <TextBlock x:Name="HourSizeLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    <TextBlock Text="Renk" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                    <Button x:Name="HourColorBtn" Height="26" Margin="0,2,0,0" Cursor="Hand"
                            Background="#1F1E1D" Click="PickHourColor" ToolTip="Renk seç (Windows renk paleti)"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GroupBorder}">
                <StackPanel>
                    <TextBlock Text="DAKİKA (mm)" FontSize="12" FontWeight="Bold" Foreground="#1F1E1D" Margin="0,0,0,10"/>
                    <TextBlock Text="Yazı tipi" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MinuteFontBox" Height="26" Margin="0,2,0,8"/>
                    <TextBlock Text="Kalınlık" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="MinuteWeightBox" Height="26" Margin="0,2,0,8"/>
                    <TextBlock Text="Boyut (24-400)" Style="{StaticResource FieldLabel}"/>
                    <Slider x:Name="MinuteSizeSlider" Minimum="24" Maximum="400" TickFrequency="4"
                            IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                    <TextBlock x:Name="MinuteSizeLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    <TextBlock Text="Renk" Style="{StaticResource FieldLabel}" Margin="0,4,0,0"/>
                    <Button x:Name="MinuteColorBtn" Height="26" Margin="0,2,0,0" Cursor="Hand"
                            Background="#1F1E1D" Click="PickMinuteColor" ToolTip="Renk seç (Windows renk paleti)"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hava durumu -->
        <Border Grid.Row="1" Style="{StaticResource GroupBorder}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="HAVA DURUMU" FontSize="12" FontWeight="Bold" Foreground="#1F1E1D" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Boyut (sıcaklık yazısı)" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="WeatherSizeSlider" Minimum="10" Maximum="60" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                        <TextBlock x:Name="WeatherSizeLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>

                        <CheckBox x:Name="DetailsCheck" Content="Detayları göster (hissedilen, nem, rüzgâr)"
                                  FontSize="12" Margin="0,8,0,0"/>
                        <CheckBox x:Name="ColonCheck" Content="Saat ve dakika arasına &quot;:&quot; koy" FontSize="12"
                                  Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Width="150">
                        <TextBlock Text="Renk" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="WeatherColorBtn" Height="26" Margin="0,2,0,6" Cursor="Hand"
                                Background="#1F1E1D" Click="PickWeatherColor" ToolTip="Renk seç (Windows renk paleti)"/>
                        <TextBlock Text="Konum" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PositionBox" Height="26" Margin="0,2,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Saatin altında" Tag="Below"/>
                            <ComboBoxItem Content="Saatin üstünde" Tag="Above"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Şehir" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                <ComboBox x:Name="CityBox" Height="28"/>

                <TextBlock Text="Konum ayarı (px)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Yatay (X)" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="WeatherOffsetXSlider" Minimum="-200" Maximum="200" TickFrequency="4"
                                IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                        <TextBlock x:Name="WeatherOffsetXLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dikey (Y)" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="WeatherOffsetYSlider" Minimum="-200" Maximum="200" TickFrequency="4"
                                IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                        <TextBlock x:Name="WeatherOffsetYLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- TARİH -->
        <Border Grid.Row="2" Style="{StaticResource GroupBorder}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="TARİH" FontSize="12" FontWeight="Bold" Foreground="#1F1E1D" Margin="0,0,0,10"/>

                <CheckBox x:Name="DateCheck" Content="Tarihi göster (25.08.2026 - Salı)" FontSize="12"
                          Margin="0,0,0,8"/>
                <CheckBox x:Name="CalendarCheck" Content="Widget'ta mini takvim göster" FontSize="12"
                          Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Takvim rengi" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" x:Name="CalendarColorBtn" Height="26" Width="80" Cursor="Hand"
                            Background="#1F1E1D" Click="PickCalendarColor" ToolTip="Renk seç"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Yazı tipi" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DateFontBox" Height="26" Margin="0,2,0,8"/>
                        <TextBlock Text="Kalınlık" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DateWeightBox" Height="26" Margin="0,2,0,8"/>
                        <TextBlock Text="Boyut (8-80)" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="DateSizeSlider" Minimum="8" Maximum="80" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                        <TextBlock x:Name="DateSizeLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Width="150">
                        <TextBlock Text="Renk" Style="{StaticResource FieldLabel}"/>
                        <Button x:Name="DateColorBtn" Height="26" Margin="0,2,0,6" Cursor="Hand"
                                Background="#1F1E1D" Click="PickDateColor" ToolTip="Renk seç (Windows renk paleti)"/>
                        <TextBlock Text="Konum" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DatePositionBox" Height="26" Margin="0,2,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Saatin üstünde" Tag="Above"/>
                            <ComboBoxItem Content="Saatin altında" Tag="Below"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Konum ayarı (px)" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Yatay (X)" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="DateOffsetXSlider" Minimum="-200" Maximum="200" TickFrequency="4"
                                IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                        <TextBlock x:Name="DateOffsetXLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dikey (Y)" Style="{StaticResource FieldLabel}"/>
                        <Slider x:Name="DateOffsetYSlider" Minimum="-200" Maximum="200" TickFrequency="4"
                                IsSnapToTickEnabled="True" ValueChanged="Any_Changed"/>
                        <TextBlock x:Name="DateOffsetYLabel" FontSize="10" Foreground="#999" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Genel -->
        <Border Grid.Row="3" Style="{StaticResource GroupBorder}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="GENEL" FontSize="12" FontWeight="Bold" Foreground="#1F1E1D" Margin="0,0,0,10"/>

                <CheckBox x:Name="TopMostCheck" Content="Widget her zaman üstte gösterilsin" FontSize="12"/>
                <CheckBox x:Name="LockCheck" Content="Konumu sabitle (sürükleme kapalı, konum hatırlanır)" FontSize="12"
                          Margin="0,6,0,0"/>
                <CheckBox x:Name="AutoStartCheck" Content="Windows açılınca otomatik başlat" FontSize="12"
                          Margin="0,6,0,0"/>
                <CheckBox x:Name="ChimeCheck" Content="Saat başında uyarı sesi çal" FontSize="12"
                          Margin="0,6,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="SoundBox" Height="26"/>
                    <Button Grid.Column="1" x:Name="PreviewBtn" Content="Dinle" Width="70" Height="26"
                            Margin="8,0,0,0" Cursor="Hand" Click="PreviewSound_Click"
                            Background="#E4E4E6" BorderThickness="0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Butonlar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,4">
            <Button Content="Uygula" Click="Apply_Click" Style="{StaticResource ActionBtn}"
                    Background="#3498DB" Foreground="White"/>
            <Button Content="Kaydet" Click="Save_Click" Style="{StaticResource ActionBtn}"
                    Background="#1F1E1D" Foreground="White" Margin="10,0,0,0"/>
            <Button Content="Vazgeç" Click="Cancel_Click" Style="{StaticResource ActionBtn}"
                    Background="#E4E4E6" Foreground="#1F1E1D" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
