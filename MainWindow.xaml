<Window x:Class="WindowsClockWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Saat"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Ayarlar" Click="Settings_Click"/>
            <Separator/>
            <MenuItem Header="Takvim" Click="Calendar_Click"/>
            <Separator/>
            <MenuItem Header="Kapat" Click="Close_Click"/>
            <Separator/>
            <MenuItem x:Name="FooterItem" Header="xpow3r 2026" IsEnabled="False"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid>
        <Border x:Name="WidgetBorder" Margin="10" CornerRadius="14"
                Padding="22,10,22,12" Background="Transparent">

            <DockPanel LastChildFill="True">
                <!-- Tarih: saatin üstünde/altında, kodla konumlandırılır -->
                <TextBlock x:Name="DateText" DockPanel.Dock="Top" FontSize="14"
                           Visibility="Collapsed" Margin="0,2,0,0"/>

                <!-- Mini takvim: en altta -->
                <Border x:Name="CalendarPanel" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- Ay / Yıl başlığı + ok butonları -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="CalPrevBtn" Text="◀" FontSize="10"
                                       Cursor="Hand" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Opacity="0.5" MouseLeftButtonDown="CalPrev_Click"/>
                            <TextBlock Grid.Column="1" x:Name="CalMonthLabel" FontSize="11"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="CalNextBtn" Text="▶" FontSize="10"
                                       Cursor="Hand" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Opacity="0.5" MouseLeftButtonDown="CalNext_Click"/>
                        </Grid>

                        <!-- Gün isimleri -->
                        <Grid x:Name="CalDayHeaders" Margin="0,0,0,2"/>
                        <!-- Gün numaraları -->
                        <Grid x:Name="CalDays"/>
                        <!-- Hatırlatma detayları -->
                        <TextBlock x:Name="ReminderDetailsText" FontSize="9" Opacity="0.55"
                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="200"/>
                    </StackPanel>
                </Border>

                <!-- Hava durumu: saatin üstünde/altında, soldan hizalı; boşluk kodla ayarlanır -->
                <StackPanel x:Name="WeatherPanel" DockPanel.Dock="Bottom"
                            Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="WeatherIcon" FontFamily="Segoe UI Symbol"
                               FontSize="28" VerticalAlignment="Center"
                               LineStackingStrategy="BlockLineHeight">&#x2601;</TextBlock>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TempText" FontSize="20" FontWeight="SemiBold">--°</TextBlock>
                            <TextBlock x:Name="DescText" Margin="8,0,0,0" FontSize="11" Opacity="0.75"
                                       VerticalAlignment="Center">yükleniyor…</TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="DetailsText" FontSize="10" Opacity="0.6"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Saat: parçalar glif üstlerinden hizalı (küçük olan kodla aşağı kaydırılır) -->
                <StackPanel x:Name="ClockRow" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock x:Name="HourText" VerticalAlignment="Top">00</TextBlock>
                    <TextBlock x:Name="ColonText" Text=":" Margin="3,0" VerticalAlignment="Top"/>
                    <TextBlock x:Name="MinuteText" VerticalAlignment="Top">00</TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
