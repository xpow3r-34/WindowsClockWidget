<Window x:Class="WindowsClockWidget.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsClockWidget"
        Title="Takvim"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F7F7F8"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GroupBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <local:RepeatTypeConverter x:Key="RepeatConv"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <!-- Sol: Aylık takvim -->
        <Border Grid.Column="0" Style="{StaticResource GroupBorder}">
            <StackPanel>
                <!-- Ay/Yıl + oklar -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PrevBtn" Text="◀" FontSize="14"
                               Cursor="Hand" VerticalAlignment="Center" Margin="0,0,12,0"
                               Opacity="0.5" MouseLeftButtonDown="Prev_Click"/>
                    <TextBlock Grid.Column="1" x:Name="MonthLabel" FontSize="14"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="NextBtn" Text="▶" FontSize="14"
                               Cursor="Hand" VerticalAlignment="Center" Margin="12,0,0,0"
                               Opacity="0.5" MouseLeftButtonDown="Next_Click"/>
                </Grid>

                <!-- Gün isimleri -->
                <Grid x:Name="DayHeaders" Margin="0,0,0,4"/>

                <!-- Takvim günleri -->
                <Grid x:Name="DayGrid"/>
            </StackPanel>
        </Border>

        <!-- Sağ: Seçili günün hatırlatmaları -->
        <Border Grid.Column="2" Style="{StaticResource GroupBorder}">
            <StackPanel>
                <TextBlock x:Name="SelectedDateLabel" FontSize="12" FontWeight="Bold"
                           Foreground="#1F1E1D" Margin="0,0,0,8"/>

                <ListBox x:Name="ReminderListBox" BorderThickness="0" FontSize="11"
                         MinHeight="120" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ReminderList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" FontSize="12"/>
                                    <TextBlock FontSize="10" Opacity="0.6">
                                        <Run Text="{Binding DateTime, StringFormat='{}{0:HH:mm}'}"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Repeat, Converter={StaticResource RepeatConv}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✏" FontSize="12" Cursor="Hand"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.5"
                                           MouseLeftButtonDown="EditReminder_Click"/>
                                <TextBlock Grid.Column="2" Text="🗑" FontSize="12" Cursor="Hand"
                                           VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.5"
                                           MouseLeftButtonDown="DeleteReminder_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Hatırlatma Ekle" Click="AddReminder_Click"
                        Style="{StaticResource ActionBtn}"
                        Background="#3498DB" Foreground="White" Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
